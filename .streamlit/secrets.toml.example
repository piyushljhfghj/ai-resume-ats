# Copy to .streamlit/secrets.toml (local) or paste into the app's
# Settings -> Secrets on Streamlit Community Cloud. Never commit the real file.

[auth]
# Must match an "Authorized redirect URI" on the Google OAuth client.
# Local:  http://localhost:8501/oauth2callback
# Cloud:  https://ai-resume-ats-008.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Long random string that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_RANDOM_HEX"

[auth.google]
client_id = "REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Optional. Leave both empty to allow any verified Google account.
[access]
allowed_emails = []        # e.g. ["you@gmail.com", "teacher@college.edu"]
allowed_domains = []       # e.g. ["college.edu"]
